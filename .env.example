# Servidor (NODE_ENV=production é definido por npm run start:local-prod)
HOST=127.0.0.1
PORT=3001
# Produção local (UI na :3001). Dev com Vite: http://localhost:5173
CORS_ORIGIN=http://127.0.0.1:3001
FORJA_API_TOKEN=altere-para-um-token-longo-e-aleatorio

# Workspace (caminho absoluto ou relativo a backend/) — onde os projetos forjados são criados.
# Vazio = usa backend/dev (dentro do próprio repo, já no .gitignore). Só aponte pra fora do
# projeto se você realmente quiser os projetos gerados soltos em outra pasta.
FORJA_WORKSPACE_ROOT=

# LLM — provedor padrão da forja
# gemini | claude | openai | ollama | cursor
FORJA_LLM_PROVIDER=ollama

# Gemini (recomendado para Arquiteto/Codificador se tiver key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Claude / Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI-compatible (OpenAI, Azure, proxies Claude/GPT, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

# Ollama (produção local sem keys cloud)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b

# Modelos "economy" — usados só na revisão sênior opcional (security/qa/devops/reporter/human),
# nunca no arquiteto/codificador/depurador/curador (ver ADR-010). Deixe em branco pra usar o
# default de cada provedor.
GEMINI_MODEL_ECONOMY=
ANTHROPIC_MODEL_ECONOMY=claude-haiku-4-5-20251001
OPENAI_MODEL_ECONOMY=gpt-4.1-mini
OLLAMA_MODEL_ECONOMY=qwen2.5-coder:3b

# Cursor Agent (CLI headless, api.cursor.sh) — opcional.
# Sem CURSOR_API_KEY, usa a sessão local já autenticada via `cursor-agent login`
# (exige o CLI instalado: curl https://cursor.com/install -fsS | bash). Nunca entra
# no fallback automático de outro provedor — só roda quando escolhido explicitamente.
CURSOR_API_KEY=
CURSOR_MODEL=auto
# CURSOR_AGENT_BIN=cursor-agent

FORJA_LLM_TIMEOUT_MS=300000
FORJA_LLM_RETRIES=2

# Segurança — produção local
FORJA_REQUIRE_DOCKER=true
FORJA_ALLOW_MOCKS=false
# Só true se quiser bind em 0.0.0.0 (não recomendado)
FORJA_ALLOW_PUBLIC_BIND=false
FORJA_SANDBOX_PORT=4000
FORJA_DEPLOY_PORT=5100
FORJA_STAGING_PORT=5200

# Watchdog (scripts/forja-service.js watch) — falhas seguidas de /api/health antes de reiniciar.
# Baixo demais derruba o processo durante operações síncronas legítimas e demoradas
# (ex.: docker build da sandbox de QA/Segurança). Ver docs/adr/006.
FORJA_WATCH_UNHEALTHY_THRESHOLD=3

# Squad (Fase 1) — opcional. Sem isso, tokens bootstrap lead-/qa-/sre- derivados do admin.
# FORJA_TEAM_JSON=[{"name":"Ana","role":"lead","token":"..."},{"name":"Bia","role":"qa","token":"..."},{"name":"Cris","role":"sre","token":"..."}]
# FORJA_REQUIRE_GIT_PR=false

# Frontend (só necessário se UI e API em hosts/portas diferentes)
# VITE_API_BASE=http://127.0.0.1:3001
# VITE_WS_URL=ws://127.0.0.1:3001
